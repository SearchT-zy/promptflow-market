# PromptFlow 环境配置（复制为 backend/.env 生效）

# 数据库：开发用 SQLite；生产切 PostgreSQL，如 postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///data/promptflow.db

# JWT
JWT_SECRET=please-change-me-in-production
JWT_EXPIRE_MINUTES=10080

# 双模式开关：false = 开源自部署模式（关闭交易相关能力，仅模板库+编辑器+导出）
MARKETPLACE_ENABLED=true

# 公开站点地址（用于导出物/分享链接中的来源 URL）
PUBLIC_BASE_URL=http://127.0.0.1:5173

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 首次启动自动建表与种子数据
AUTO_SEED=true
